<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\CollectorShop</DockerfileContext>
    <DockerComposeProjectPath>..\CollectorShop\docker-compose.dcproj</DockerComposeProjectPath>
    <UserSecretsId>9ffbb093-24a4-46b7-8337-a9f5dac14d45</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\CollectorShop\.dockerignore" Link=".dockerignore">
      <DependentUpon>$(DockerDefaultDockerfile)</DependentUpon>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.8" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.14.14" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="user_documents\" />
  </ItemGroup>

</Project>
